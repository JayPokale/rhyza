meta {
  name: Quote
  type: http
  seq: 3
}

post {
  url: http://localhost/quote
  body: json
  auth: none
}

body:json {
  {
    "senderWalletAddressId":"a1469618-077a-447d-b5a3-a9ed11265a63",
    "incomingPaymentId":"{{incomingPaymentId}}",
    "debitAmount":{
      "assetCode":"USD",
      "assetScale": 2,
      "value":100
    }
  }
}

script:post-response {
  const body = res.getBody();
  
  if (body?.id) {
    bru.setVar("quoteId", body.id);
  }
}
