meta {
  name: Create Receiver Wallet Address
  type: http
  seq: 3
}

post {
  url: http://{{baseUrl}}/wallet-addresses
  body: json
  auth: inherit
}

body:json {
  {
    "assetCode": "USD",
    "address": "https://test.com/receiver",
    "publicName": "test receiver"
  }
}

script:post-response {
  const body = res.getBody();
  
  if (body?.id) {
    bru.setVar("receiverWalletAddress", body.address);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
