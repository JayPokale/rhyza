meta {
  name: List Payment Intents
  type: http
  seq: 10
}

get {
  url: http://{{adminApiUrl}}/payment-intents?first=20&sortOrder=desc
  body: none
  auth: none
}

docs {
  Cursor pagination. Copy `pagination.endCursor` from a response into
  `&cursor=` to page forward, or `pagination.startCursor` with `&last=`
  to page back.

  Cursors are opaque and are bound to the query that issued them: keep
  `sortOrder` and any filters identical while paging, or the request is
  rejected with 400.
}
