meta {
  name: Incoming Payment
  type: http
  seq: 4
}

post {
  url: http://{{adminApiUrl}}/incoming-payments
  body: json
  auth: none
}

body:json {
  {
    "walletAddress": "test.com/receiver",
    "incomingAmount": 100
  }
}

script:post-response {
  const body = res.getBody();
  
  if (body?.id) {
    bru.setVar("incomingPaymentId", body.id);
  }
}
