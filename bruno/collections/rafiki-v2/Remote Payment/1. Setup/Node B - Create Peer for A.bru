meta {
  name: Node B - Create Peer for A
  type: http
  seq: 6
}

post {
  url: http://{{adminB}}/peers
  body: json
  auth: none
}

body:json {
  {
    "id": "9f3c1e2a-4b5d-4c6e-8a7f-1b2c3d4e5f60",
    "name": "Node A",
    "assetCode": "USD",
    "assetScale": 2,
    "ilpStaticAddress": "g.rafiki",
    "http": {
      "outgoing": {
        "endpoint": "http://open-payments-resource-service:3002/ilp",
        "authToken": "two-node-token"
      }
    }
  }
}

tests {
  test("created or already exists", function () {
    expect([201, 409]).to.include(res.getStatus());
  });
}

docs {
  Reverse peer on **Node B** representing **Node A**, needed for the
  receive/settlement leg (Node B fulfilling Node A's ILP packets). That leg is
  not implemented yet - there is no `/ilp` ingress, and no receive-side "accept"
  path (no webhook event, no Admin endpoint). Included so the two-node topology
  is symmetric and ready; not exercised by the sender-side Flow.

  `ilpStaticAddress` is `g.rafiki` - both nodes currently advertise the same
  stubbed prefix (`STUB_DESTINATION_ILP_PREFIX`).
}
