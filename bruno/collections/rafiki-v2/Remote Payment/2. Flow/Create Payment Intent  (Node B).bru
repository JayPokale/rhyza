meta {
  name: Create Payment Intent  (Node B)
  type: http
  seq: 1
}

post {
  url: http://{{adminB}}/payment-intents
  body: json
  auth: none
}

body:json {
  {
    "walletAddress": "test.com/receiver",
    "incomingAmount": 1000
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.id) {
    bru.setVar("receiverIntentIdB", body.id);
  }
  if (body?.openPaymentsUrl) {
    bru.setVar("receiverIntentUrl", body.openPaymentsUrl);
  }
}

tests {
  test("intent created", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("openPaymentsUrl returned", function () {
    expect(res.getBody()?.openPaymentsUrl).to.be.a("string");
  });
}

docs {
  Creates the incoming payment (payment intent) on **Node B**.

  The response `openPaymentsUrl` is a **Docker-internal** URL
  (`http://open-payments-resource-service-b:3002/incoming-payments/{id}`).
  Bruno never fetches it directly - it is stored as `receiverIntentUrl` and
  handed to Node A's quote, which fetches it server-side over the shared
  `rafiki-v2` network.

  Requires `OPEN_PAYMENTS_URL` to be set on Node B's admin service (it is, in
  `docker-compose.node-b.yaml`); otherwise `openPaymentsUrl` is omitted.
}
