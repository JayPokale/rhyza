meta {
  name: Get Incoming Payment (Node B)
  type: http
  seq: 1
}

get {
  url: http://{{opBHost}}/incoming-payments/{{receiverIntentIdB}}
  body: none
  auth: none
}

docs {
  Reads the incoming payment on **Node B** via its Open Payments server, exposed
  on host port `4002`. Check `receivedAmount` against `incomingAmount` and the
  `completed` flag to verify the payment intent finished - the Admin API has no
  Get Payment endpoint yet, so this is the verification step.
}
