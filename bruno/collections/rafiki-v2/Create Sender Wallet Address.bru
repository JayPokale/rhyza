meta {
  name: Create Sender Wallet Address
  type: http
  seq: 4
}

post {
  url: http://{{baseUrl}}/wallet-addresses
  body: json
  auth: inherit
}

body:json {
  {
    "assetCode": "USD",
    "address": "test.com/sender",
    "publicName": "test sender"
  }
}

script:post-response {
  const body = res.getBody();
  
  if (body?.address) {
    bru.setVar("senderWalletAddress", body.address);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
