{
  "name": "api",
  "scripts": {
    "dev": "tsx src/index.ts",
    "docker:up": "docker compose -f ./docker/docker-compose.yaml down --volumes && docker compose -f ./docker/docker-compose.yaml up --build",
    "docker:peer:up": "docker compose -f docker/docker-compose.yaml -f docker/peer/docker-compose.yaml down --volumes && docker compose -f docker/docker-compose.yaml -f docker/peer/docker-compose.yaml up -d --build",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/otel": "^0.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.57.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.200.0",
    "@opentelemetry/instrumentation": "^0.57.1",
    "@opentelemetry/instrumentation-http": "^0.57.1",
    "@opentelemetry/instrumentation-pg": "^0.52.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.1",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "fastify": "^5.2.1",
    "kafkajs": "^2.2.4",
    "payments-service": "workspace:*",
    "pino": "^9.6.0",
    "telemetry": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3"
  }
}
