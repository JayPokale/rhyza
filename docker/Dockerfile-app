#FROM node:22-alpine AS base
FROM node:20-alpine AS base
WORKDIR /workspace

RUN apk update && apk add --no-cache \
    librdkafka-dev \
    cyrus-sasl-dev \
    openssl-dev \
    gcc \
    g++ \
    python3 \
    make \
    musl-dev

COPY . .

RUN BUILD_LIBRDKAFKA=0 npm i
RUN npm run build

CMD ["node", "dist/index.js"]
